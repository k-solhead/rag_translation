# .env にコピーして使う（.env は Git に含めない）
# パスワードは英数字のみにする（接続URLに埋め込むため記号は不可）
POSTGRES_PASSWORD=change-me
# ホスト側の公開ポート（重なる場合に変更）
APP_PORT=8501
DB_PORT=5432

# ---- 翻訳機能 ----
# LM Studio（ローカル LLM）の接続先と同時リクエスト数
LMSTUDIO_BASE_URL=http://192.168.11.83:1234/v1
LMSTUDIO_CONCURRENCY=1
# Ollama の接続先（空にすると使わない）、同時リクエスト数、コンテキスト長
OLLAMA_BASE_URL=http://192.168.11.83:11434
OLLAMA_CONCURRENCY=1
OLLAMA_NUM_CTX=8192
# Claude API のキー（Teamプランの API クレジットを Claude Console に紐付けて発行）。空なら Claude は使わない
ANTHROPIC_API_KEY=
# 選択肢に出す Claude のモデル（カンマ区切り）と同時リクエスト数
CLAUDE_MODELS=claude-haiku-5-5,claude-sonnet-5-5
CLAUDE_CONCURRENCY=4
# OpenAI API のキー（platform.openai.com で発行）。空なら OpenAI は使わない
OPENAI_API_KEY=
# 選択肢に出す OpenAI のモデル（カンマ区切り）と同時リクエスト数
OPENAI_MODELS=gpt-6-luna,gpt-6.1-sol
OPENAI_CONCURRENCY=4
# Gemini API のキー（Google AI Studio で発行。原稿を送るため課金を有効にした有料枠のキーを推奨）。空なら Gemini は使わない
GEMINI_API_KEY=
# 選択肢に出す Gemini のモデル（カンマ区切り）と同時リクエスト数
GEMINI_MODELS=gemini-3.8-flash
GEMINI_CONCURRENCY=4
# 任意: 推論の深さ（例: low）。空なら各社の既定
OPENAI_REASONING_EFFORT=
GEMINI_REASONING_EFFORT=
# OpenAI / Gemini の出力トークン上限（推論型モデルは推論にも使うため多めに）
CLOUD_MAX_TOKENS=8192
